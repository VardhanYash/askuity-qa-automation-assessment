{
  "name": "askuity-qa-automation",
  "type": "module",
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@wdio/cli": "^9.21.1",
    "@wdio/globals": "^9.17.0",
    "@wdio/local-runner": "^9.21.0",
    "@wdio/mocha-framework": "^9.21.0",
    "@wdio/spec-reporter": "^9.20.0",
    "expect-webdriverio": "^5.5.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "test": "npm run test:stable && npm run test:mobile",
    "test:desktop": "wdio run ./wdio.conf.ts",
    "test:mobile": "wdio run ./wdio.mobile.conf.ts",
    "test:stable": "wdio run ./wdio.conf.ts --mochaOpts.grep @knownBug --mochaOpts.invert",
    "test:bugs": "wdio run ./wdio.conf.ts --mochaOpts.grep @knownBug",
    "typecheck": "tsc --noEmit"
  },
  "description": "WebdriverIO + TypeScript end-to-end tests for the Morrow Supply shopping cart exercise",
  "private": true
}
